# Obsidian per-machine UI state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# OS cruft
.DS_Store
.trash/

# Heavy coursework media — kept on disk in raw/ as source of truth, not git-tracked
raw/coursework/**/*.pdf
raw/coursework/**/*.pptx
raw/coursework/**/*.cmbl
raw/coursework/**/*.xlsx
raw/coursework/10th/**/*.docx
raw/coursework/12th/**/*.docx
raw/coursework/**/*.CMBL
raw/coursework/History-archive/
raw/coursework/Economics-archive/

# Secrets — never commit these
raw/scripts/.env
*.env
Notes/*pass*
Notes/*cred*

# Nested git repos — each is its own project/repo, never tracked here
raw/scripts/
raw/vision/
raw/quant model/

# Heavy exports and archives — on-disk only
raw/assets/chatgpt/
raw/chatgpt/
raw/vision.zip
raw/quant model.zip
raw/personal quant model.zip

# obsidian-git plugin credential input — never commit
.obsidian/plugins/obsidian-git/.git_credentials*
